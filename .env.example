# wickwatch configuration (copy to .env)
HOST=0.0.0.0
PORT=3000
BASE_PATH=/
# false, true, a hop count (e.g. 1) or a comma-separated list of proxy IPs/CIDRs
TRUST_PROXY=false
# fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored broker credentials and TOTP secrets. Keep it safe and backed up.
MASTER_KEY=
DATABASE_URL=file:./data/wickwatch.db
LABEL_PREFIX=wickwatch
DEFAULT_LOCALE=en
# Adapters: demo (fake data); RUNTIME_ADAPTER=docker manages labelled containers; BROKER_ADAPTER=ctrader-cli
RUNTIME_ADAPTER=demo
BROKER_ADAPTER=demo
# Parameter files: demo (JSON) or cbotset (with BROKER_ADAPTER=ctrader-cli)
CONFIG_ADAPTER=demo
# cTrader CLI for wickwatch's own queries: local (installed CLI) or container (official image, needs RUNTIME_ADAPTER=docker; default in the image)
# CTRADER_CLI=container
# CTRADER_CLI_PATH=ctrader-cli
# Image the bots run with; pinned to a version or digest, never latest
# CTRADER_IMAGE=ghcr.io/spotware/ctrader-console:5.9.11
# Docker restart policy of instances wickwatch creates: on-failure, unless-stopped or no
# INSTANCE_RESTART_POLICY=on-failure
# Sampling of balance/equity for challenge limits
ACCOUNT_POLL_SECONDS=60
# Docker API for RUNTIME_ADAPTER=docker (through docker-socket-proxy)
DOCKER_HOST=tcp://socket-proxy:2375
# Notifications (docs/CONFIGURATION.md#notifications): JSON POST per alert change, GET ping after each check
ALERT_WEBHOOK_URL=
HEARTBEAT_URL=
ALERT_CHECK_SECONDS=60
# Daily summary to ALERT_WEBHOOK_URL at this local time (off when unset)
# DAILY_SUMMARY_TIME=21:30
# DAILY_SUMMARY_TIMEZONE=Europe/Berlin
# Hourly clock check against an external time source (RUNTIME_ADAPTER=docker); off to switch it off
# CLOCK_CHECK_URL=https://www.cloudflare.com/cdn-cgi/trace
# Footer links: the source code of this version (point it at your fork if you changed wickwatch) and support; SUPPORT_URL=off hides it
# SOURCE_URL=https://github.com/wickwatch/wickwatch
# SUPPORT_URL=https://ko-fi.com/mmohrx
# Database backups (docs/CONFIGURATION.md#backups-and-restore) and retention
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# BACKUP_DIR=data/backups
AUDIT_RETENTION_DAYS=365
# Folders (defaults shown; relative to where the server starts)
# ALGOS_DIR=data/algos
# CHALLENGE_TEMPLATES_DIR=templates/challenges
# WEB_DIST_DIR= (found automatically; only for a server outside the image)
# All variables: docs/CONFIGURATION.md
